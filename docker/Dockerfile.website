###############################################################################
# Stage 1 - Build
###############################################################################

FROM node:22-alpine AS builder

WORKDIR /app

COPY apps/website/package*.json ./

RUN npm ci

COPY apps/website .

RUN npm run build

###############################################################################
# Stage 2 - Production
###############################################################################

FROM nginx:1.28-alpine

LABEL org.opencontainers.image.title="Sandtongrid Technologies Website"
LABEL org.opencontainers.image.description="Production image for the Sandtongrid Technologies website."
LABEL org.opencontainers.image.vendor="Sandtongrid Technologies"
LABEL org.opencontainers.image.version="1.0.0"

RUN rm -rf /usr/share/nginx/html/*

COPY docker/nginx/website.conf /etc/nginx/conf.d/default.conf

COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s \
            --timeout=5s \
            --start-period=10s \
            --retries=3 \
CMD wget --quiet --tries=1 --spider http://127.0.0.1 || exit 1

STOPSIGNAL SIGQUIT

CMD ["nginx","-g","daemon off;"]